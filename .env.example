# Local LLM (Ollama). No cloud, no data leaves the machine.
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:14b

# Database — the agent connects as a READ-ONLY role.
# (Real values are never committed. This file only documents the shape.)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market_intel
DB_USER=agent_reader
DB_PASSWORD=__set_me__
